generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Reminder {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  activationCode       String?
  activationContact    String?
  dueAt                DateTime
  priority             String   @default("medium")
  category             String?
  remindBeforeDays     Int      @default(3)
  remindBeforeHours    Int      @default(24)
  overdueRemindEnabled Boolean  @default(true)
  recurrenceType       String?
  recurrenceInterval   Int?
  upcomingNotifiedAt   DateTime?
  overdueNotifiedAt    DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  attachments          Attachment[]
  licenseStoreAccounts LicenseStoreAccount[]

  @@index([dueAt])
  @@index([completedAt])
  @@index([deletedAt])
}


model LicenseStoreAccount {
  id             String    @id @default(cuid())
  shopName       String
  phone          String
  remoteCode     String
  remotePassword String
  isOtherAccount Boolean   @default(false)
  expiresAt      DateTime
  activationCode String
  reminderId     String?
  reminder       Reminder? @relation(fields: [reminderId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([expiresAt])
  @@index([activationCode])
  @@index([reminderId])
  @@index([deletedAt])
}

model AppSetting {
  id                       Int      @id @default(1)
  appName                  String   @default("到期提醒")
  timezone                 String   @default("Asia/Shanghai")
  defaultRemindBeforeDays  Int      @default(3)
  defaultRemindBeforeHours Int      @default(24)
  overdueRepeatEnabled     Boolean  @default(true)
  dailyRemindTime          String   @default("09:00")
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail        String?
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPassEncrypted        String?
  smtpFromEmail            String?
  smtpFromName             String?
  otpSecretEncrypted       String?
  otpConfiguredAt          DateTime?
  reminderEmailEnabled     Boolean  @default(true)
  reminderEmailInterval    Int      @default(1800)
  notifyStartHour          Int      @default(9)
  notifyEndHour            Int      @default(22)
  r2Endpoint               String?
  r2AccessKey              String?
  r2SecretKey              String?
  r2Bucket                 String?
  r2PublicUrl              String?
  r2CacheControl           String   @default("public, max-age=86400")
  telegramBotEnabled       Boolean  @default(false)
  telegramBotTokenEncrypted String?
  telegramBotChatId        String?
  telegramBotName          String?
  telegramBotUsername      String?
  telegramBotLastTestAt    DateTime?
  telegramBotLastTestStatus String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model TelegramBinding {
  id           String   @id @default(cuid())
  chatId       String   @unique
  username     String?
  firstName    String?
  boundAt      DateTime @default(now())
  lastActiveAt DateTime?
  unboundAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([chatId])
  @@index([unboundAt])
}

model TelegramBindCode {
  id        String   @id @default(cuid())
  code      String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  chatId    String?
  createdAt DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}

model AuthSession {
  id               String   @id @default(cuid())
  sessionTokenHash String
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@index([expiresAt])
}

model TrustedDevice {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  deviceName  String?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@index([revokedAt])
}

model TaskRunLog {
  id         String   @id @default(cuid())
  task       String
  startedAt  DateTime
  finishedAt DateTime?
  success    Boolean
  summary    String?
  createdAt  DateTime @default(now())

  @@index([startedAt])
}

model Image {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  r2Key        String
  url          String
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
}

model WebAuthnCredential {
  id                String   @id @default(cuid())
  credentialId      String   @unique
  publicKey         String
  counter           BigInt   @default(0)
  credentialType    String   @default("public-key")
  authenticatorType String   @default("platform")
  deviceName        String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?

  @@index([credentialId])
}

model Attachment {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  r2Key        String
  url          String
  reminderId   String?
  reminder     Reminder? @relation(fields: [reminderId], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([reminderId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([completedAt])
  @@index([deletedAt])
  @@index([createdAt])
}

model NotificationEvent {
  id            String         @id @default(cuid())
  source        String
  eventType     String
  payload       String
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  eventId   String?
  event     NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  groupId   String
  group     NotificationGroup @relation(fields: [groupId], references: [id])
  title     String
  summary   String?
  priority  Int               @default(2)
  status    String            @default("Created")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  jobs      QueueJob[]

  @@index([status])
  @@index([groupId])
  @@index([createdAt])
}

model QueueJob {
  id             String               @id @default(cuid())
  notificationId String
  notification   Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelId      String
  channel        NotificationChannel  @relation(fields: [channelId], references: [id])
  templateId     String
  template       NotificationTemplate @relation(fields: [templateId], references: [id])
  priority       Int                  @default(2)
  retryCount     Int                  @default(0)
  maxRetry       Int                  @default(5)
  status         String               @default("Pending")
  nextExecuteAt  DateTime             @default(now())
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sendLogs       SendLog[]
  pushLedger     PushLedger?

  @@index([status])
  @@index([nextExecuteAt])
  @@index([notificationId])
}

model NotificationChannel {
  id        String     @id @default(cuid())
  type      String
  name      String
  config    String     @default("{}")
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  jobs      QueueJob[]

  @@index([type])
  @@index([enabled])
}

model NotificationTemplate {
  id          String     @id @default(cuid())
  name        String
  channelType String
  content     String
  enabled     Boolean    @default(true)
  jobs        QueueJob[]

  @@index([channelType])
  @@index([enabled])
}

model NotificationGroup {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  enabled       Boolean        @default(true)
  notifications Notification[]

  @@index([enabled])
}

model NotificationApiKey {
  id        String    @id @default(cuid())
  name      String
  apiKey    String    @unique
  enabled   Boolean   @default(true)
  expiresAt DateTime?

  @@index([apiKey])
  @@index([enabled])
}

model SendLog {
  id         String   @id @default(cuid())
  queueJobId String
  queueJob   QueueJob @relation(fields: [queueJobId], references: [id], onDelete: Cascade)
  request    String
  response   String
  result     String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([queueJobId])
  @@index([createdAt])
}

model PushLedger {
  id             String    @id @default(cuid())
  notificationId String?
  queueJobId     String?   @unique
  queueJob       QueueJob? @relation(fields: [queueJobId], references: [id], onDelete: SetNull)
  channelId      String?
  channelType    String
  channelName    String
  target         String?
  title          String
  content        String
  rawPayload     String    @default("{}")
  businessType   String?
  businessId     String?
  status         String    @default("Pending")
  retryCount     Int       @default(0)
  attemptCount   Int       @default(0)
  request        String?
  response       String?
  error          String?
  durationMs     Int?
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  lastRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([channelType])
  @@index([businessId])
  @@index([notificationId])
}

model WebAuthnChallenge {
  id        String   @id
  challenge String
  expiresAt DateTime
}
