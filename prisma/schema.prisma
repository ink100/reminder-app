generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Reminder {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  activationCode       String?
  activationContact    String?
  dueAt                DateTime
  priority             String   @default("medium")
  category             String?
  remindBeforeDays     Int      @default(3)
  remindBeforeHours    Int      @default(24)
  overdueRemindEnabled Boolean  @default(true)
  recurrenceType       String?
  recurrenceInterval   Int?
  upcomingNotifiedAt   DateTime?
  overdueNotifiedAt    DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  attachments          Attachment[]

  @@index([dueAt])
  @@index([completedAt])
  @@index([deletedAt])
}

model AppSetting {
  id                       Int      @id @default(1)
  appName                  String   @default("到期提醒")
  timezone                 String   @default("Asia/Shanghai")
  defaultRemindBeforeDays  Int      @default(3)
  defaultRemindBeforeHours Int      @default(24)
  overdueRepeatEnabled     Boolean  @default(true)
  dailyRemindTime          String   @default("09:00")
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail        String?
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPassEncrypted        String?
  smtpFromEmail            String?
  smtpFromName             String?
  otpSecretEncrypted       String?
  otpConfiguredAt          DateTime?
  reminderEmailEnabled     Boolean  @default(true)
  reminderEmailInterval    Int      @default(1800)
  notifyStartHour          Int      @default(9)
  notifyEndHour            Int      @default(22)
  r2Endpoint               String?
  r2AccessKey              String?
  r2SecretKey              String?
  r2Bucket                 String?
  r2PublicUrl              String?
  r2CacheControl           String   @default("public, max-age=86400")
  telegramBotEnabled       Boolean  @default(false)
  telegramBotTokenEncrypted String?
  telegramBotChatId        String?
  telegramBotName          String?
  telegramBotUsername      String?
  telegramBotLastTestAt    DateTime?
  telegramBotLastTestStatus String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model TelegramBinding {
  id           String   @id @default(cuid())
  chatId       String   @unique
  username     String?
  firstName    String?
  boundAt      DateTime @default(now())
  lastActiveAt DateTime?
  unboundAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([chatId])
  @@index([unboundAt])
}

model TelegramBindCode {
  id        String   @id @default(cuid())
  code      String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  chatId    String?
  createdAt DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}

model AuthSession {
  id               String   @id @default(cuid())
  sessionTokenHash String
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@index([expiresAt])
}

model TrustedDevice {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  deviceName  String?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([expiresAt])
  @@index([revokedAt])
}

model TaskRunLog {
  id         String   @id @default(cuid())
  task       String
  startedAt  DateTime
  finishedAt DateTime?
  success    Boolean
  summary    String?
  createdAt  DateTime @default(now())

  @@index([startedAt])
}

model Image {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  r2Key        String
  url          String
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
}

model WebAuthnCredential {
  id                String   @id @default(cuid())
  credentialId      String   @unique
  publicKey         String
  counter           BigInt   @default(0)
  credentialType    String   @default("public-key")
  authenticatorType String   @default("platform")
  deviceName        String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?

  @@index([credentialId])
}

model Attachment {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  r2Key        String
  url          String
  reminderId   String?
  reminder     Reminder? @relation(fields: [reminderId], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  @@index([reminderId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([completedAt])
  @@index([deletedAt])
  @@index([createdAt])
}

model WebAuthnChallenge {
  id        String   @id
  challenge String
  expiresAt DateTime
}
