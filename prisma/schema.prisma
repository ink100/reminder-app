generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Reminder {
  id                   String   @id @default(cuid())
  title                String
  description          String?
  activationCode       String?
  activationContact    String?
  dueAt                DateTime
  priority             String   @default("medium")
  category             String?
  remindBeforeDays     Int      @default(3)
  remindBeforeHours    Int      @default(24)
  overdueRemindEnabled Boolean  @default(true)
  recurrenceType       String?
  recurrenceInterval   Int?
  upcomingNotifiedAt   DateTime?
  overdueNotifiedAt    DateTime?
  completedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  deletedAt            DateTime?
  attachments          Attachment[]
  licenseStoreAccount  LicenseStoreAccount?

  @@index([dueAt])
  @@index([completedAt])
  @@index([deletedAt])
}


model LicenseStoreAccount {
  id             String    @id @default(cuid())
  shopName       String
  phone          String
  remoteCode     String
  remotePassword String
  isOtherAccount Boolean   @default(false)
  expiresAt      DateTime
  activationCode String
  reminderId     String    @unique
  reminder       Reminder  @relation(fields: [reminderId], references: [id], onDelete: Restrict)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([expiresAt])
  @@index([activationCode])
  @@index([deletedAt])
}

model AppSetting {
  id                       Int      @id @default(1)
  appName                  String   @default("到期提醒")
  timezone                 String   @default("Asia/Shanghai")
  defaultRemindBeforeDays  Int      @default(3)
  defaultRemindBeforeHours Int      @default(24)
  overdueRepeatEnabled     Boolean  @default(true)
  dailyRemindTime          String   @default("09:00")
  emailNotificationsEnabled Boolean @default(false)
  notificationEmail        String?
  smtpHost                 String?
  smtpPort                 Int?
  smtpUser                 String?
  smtpPassEncrypted        String?
  smtpFromEmail            String?
  smtpFromName             String?
  otpSecretEncrypted       String?
  otpConfiguredAt          DateTime?
  reminderEmailEnabled     Boolean  @default(true)
  reminderEmailInterval    Int      @default(1800)
  notifyStartHour          Int      @default(9)
  notifyEndHour            Int      @default(22)
  r2Endpoint               String?
  r2AccessKey              String?
  r2SecretKey              String?
  r2Bucket                 String?
  r2PublicUrl              String?
  r2CacheControl           String   @default("public, max-age=86400")
  telegramBotEnabled       Boolean  @default(false)
  telegramBotTokenEncrypted String?
  telegramBotChatId        String?
  telegramBotName          String?
  telegramBotUsername      String?
  telegramBotLastTestAt    DateTime?
  telegramBotLastTestStatus String?
  voiceAssistantProvider   String   @default("openai-compatible")
  voiceAssistantConfigured Boolean  @default(false)
  voiceAssistantBaseUrl    String   @default("https://api.openai.com/v1")
  voiceAssistantApiKeyEncrypted String?
  voiceAssistantModel      String   @default("gpt-4o-mini")
  voiceAssistantSystemPrompt String @default("你是提醒事项语音助手。需要时使用工具，并简洁地用中文回复。")
  voiceAssistantAllowMutations Boolean @default(false)
  voiceAssistantDefaultVoice String @default("zh-CN-XiaoxiaoNeural")
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model TelegramBinding {
  id           String   @id @default(cuid())
  chatId       String   @unique
  username     String?
  firstName    String?
  boundAt      DateTime @default(now())
  lastActiveAt DateTime?
  unboundAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([chatId])
  @@index([unboundAt])
}

model TelegramBindCode {
  id        String   @id @default(cuid())
  code      String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  chatId    String?
  createdAt DateTime @default(now())

  @@index([code])
  @@index([expiresAt])
}

model AuthSession {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authMethod       String
  securityVersion  Int      @default(0)
  sessionTokenHash String   @unique
  expiresAt        DateTime
  ipAddress        String?
  userAgent        String?
  trustedDeviceId  String?
  trustedDevice    TrustedDevice? @relation(fields: [trustedDeviceId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  lastSeenAt       DateTime @default(now())

  @@index([expiresAt])
  @@index([userId])
  @@index([trustedDeviceId])
}

model TrustedDevice {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  securityVersion Int       @default(0)
  deviceName      String?
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  sessions    AuthSession[]

  @@index([expiresAt])
  @@index([revokedAt])
  @@index([userId])
}

model LoginThrottle {
  key             String   @id
  scope           String
  failureCount    Int      @default(0)
  windowStartedAt DateTime
  updatedAt       DateTime @updatedAt

  @@index([updatedAt])
}

model User {
  id                  String               @id @default(cuid())
  username            String               @unique
  displayName         String
  role                  String                 @default("MEMBER")
  status                String                 @default("ACTIVE")
  securityVersion       Int                    @default(0)
  activatedAt           DateTime?
  disabledAt            DateTime?

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  totpFactor            UserTotpFactor?
  sessions              AuthSession[]
  trustedDevices        TrustedDevice[]
  webAuthnCredentials   WebAuthnCredential[]
  invitationsSent       MemberInvitation[]     @relation("InvitationInviter")
  invitation            MemberInvitation?      @relation("InvitationTarget")
  pendingTotpEnrollment PendingTotpEnrollment?
  webAuthnChallenges    WebAuthnChallenge[]
}

model MemberInvitation {
  id           String   @id @default(cuid())
  tokenHash    String   @unique
  targetUserId String   @unique
  targetUser   User     @relation("InvitationTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  invitedById  String
  invitedBy    User     @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Restrict)
  expiresAt    DateTime
  consumedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([expiresAt])
  @@index([invitedById])
  @@index([targetUserId])
}

model PendingTotpEnrollment {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime @default(now())

  @@index([expiresAt])
}

model UserTotpFactor {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  secretEncrypted  String
  enabledAt        DateTime  @default(now())
  revokedAt        DateTime?
  lastAcceptedStep Int?
  createdAt        DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model TaskRunLog {
  id         String   @id @default(cuid())
  task       String
  startedAt  DateTime
  finishedAt DateTime?
  success    Boolean
  summary    String?
  createdAt  DateTime @default(now())

  @@index([startedAt])
}

model Image {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimetype     String
  size         Int
  r2Key        String
  url          String
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@index([createdAt])
  @@index([deletedAt])
}

model WebAuthnCredential {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId      String   @unique
  publicKey         String
  counter           BigInt   @default(0)
  credentialType    String   @default("public-key")
  authenticatorType String   @default("platform")
  deviceName        String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime?

  @@index([credentialId])
  @@index([userId])
}

model Attachment {
  id                    String               @id @default(cuid())
  filename              String
  originalName          String
  mimetype              String
  size                  Int
  r2Key                 String
  url                   String
  reminderId            String?
  reminder              Reminder?            @relation(fields: [reminderId], references: [id])
  attachmentType        String?
  medicineId            String?
  licenseStoreAccountId String?
  createdAt             DateTime             @default(now())
  deletedAt             DateTime?

  @@index([reminderId])
  @@index([attachmentType])
  @@index([medicineId])
  @@index([licenseStoreAccountId])
  @@index([createdAt])
  @@index([deletedAt])
}

model Todo {
  id          String    @id @default(cuid())
  title       String
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@index([completedAt])
  @@index([deletedAt])
  @@index([createdAt])
}

model NotificationEvent {
  id            String         @id @default(cuid())
  source        String
  eventType     String
  payload       String
  createdAt     DateTime       @default(now())
  notifications Notification[]

  @@index([createdAt])
}

model Notification {
  id        String             @id @default(cuid())
  eventId   String?
  event     NotificationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  groupId   String
  group     NotificationGroup @relation(fields: [groupId], references: [id])
  title     String
  summary   String?
  priority  Int               @default(2)
  status    String            @default("Created")
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  jobs      QueueJob[]

  @@index([status])
  @@index([groupId])
  @@index([createdAt])
}

model QueueJob {
  id             String               @id @default(cuid())
  notificationId String
  notification   Notification         @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  channelId      String
  channel        NotificationChannel  @relation(fields: [channelId], references: [id])
  templateId     String
  template       NotificationTemplate @relation(fields: [templateId], references: [id])
  priority       Int                  @default(2)
  retryCount     Int                  @default(0)
  maxRetry       Int                  @default(5)
  status         String               @default("Pending")
  nextExecuteAt  DateTime             @default(now())
  lockedAt       DateTime?
  lastError      String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sendLogs       SendLog[]
  pushLedger     PushLedger?

  @@index([status])
  @@index([nextExecuteAt])
  @@index([notificationId])
}

model NotificationChannel {
  id        String     @id @default(cuid())
  type      String
  name      String
  config    String     @default("{}")
  enabled   Boolean    @default(true)
  createdAt DateTime   @default(now())
  jobs      QueueJob[]

  @@index([type])
  @@index([enabled])
}

model NotificationTemplate {
  id          String     @id @default(cuid())
  name        String
  channelType String
  content     String
  enabled     Boolean    @default(true)
  jobs        QueueJob[]

  @@index([channelType])
  @@index([enabled])
}

model NotificationGroup {
  id            String         @id @default(cuid())
  name          String         @unique
  description   String?
  enabled       Boolean        @default(true)
  notifications Notification[]

  @@index([enabled])
}

model NotificationApiKey {
  id        String    @id @default(cuid())
  name      String
  apiKey    String    @unique
  enabled   Boolean   @default(true)
  expiresAt DateTime?

  @@index([apiKey])
  @@index([enabled])
}

model SendLog {
  id         String   @id @default(cuid())
  queueJobId String
  queueJob   QueueJob @relation(fields: [queueJobId], references: [id], onDelete: Cascade)
  request    String
  response   String
  result     String
  durationMs Int
  createdAt  DateTime @default(now())

  @@index([queueJobId])
  @@index([createdAt])
}

model PushLedger {
  id             String    @id @default(cuid())
  notificationId String?
  queueJobId     String?   @unique
  queueJob       QueueJob? @relation(fields: [queueJobId], references: [id], onDelete: SetNull)
  channelId      String?
  channelType    String
  channelName    String
  target         String?
  title          String
  content        String
  rawPayload     String    @default("{}")
  businessType   String?
  businessId     String?
  status         String    @default("Pending")
  retryCount     Int       @default(0)
  attemptCount   Int       @default(0)
  request        String?
  response       String?
  error          String?
  durationMs     Int?
  queuedAt       DateTime  @default(now())
  startedAt      DateTime?
  sentAt         DateTime?
  failedAt       DateTime?
  lastRetryAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([channelType])
  @@index([businessId])
  @@index([notificationId])
}

model WebAuthnChallenge {
  id               String   @id @default(cuid())
  challenge        String
  flow             String
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  browserTokenHash String
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([browserTokenHash, flow, consumedAt])
  @@index([expiresAt])
  @@index([userId])
}
