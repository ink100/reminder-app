# Database
DATABASE_URL="file:./dev.db"

# Public app URL
APP_BASE_URL="http://localhost:3000"
APP_NAME="到期提醒"

# Security secrets
# Replace with your own random values before production deployment
SESSION_SECRET="replace-with-at-least-16-random-characters"
OTP_SECRET_ENCRYPTION_KEY="replace-with-at-least-32-random-characters"

# Runtime environment
NODE_ENV="development"

# Optional SMTP settings (required only if you want email notifications)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="提醒助手"
