[Unit]
Description=Reminder Inventory Nuxt App
After=network.target hrb-license-key.service
Wants=hrb-license-key.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/apps/reminder-app
Environment=NODE_ENV=production
# Supabase DNS records include IPv6, but this VPS must connect through IPv4 only.
# Disable Node's dual-stack family racing and select IPv4 addresses first.
Environment="NODE_OPTIONS=--dns-result-order=ipv4first --no-network-family-autoselection"
Environment=HOST=127.0.0.1
Environment=PORT=63456
ExecStart=/usr/bin/node /home/ubuntu/apps/reminder-app/.output/server/index.mjs
# Node may report SIGTERM as status 143 during an intentional service restart.
SuccessExitStatus=143 SIGTERM
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
